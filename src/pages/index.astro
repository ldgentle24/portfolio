---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---

<BaseLayout title="Portfolio">
  <Nav />
  <div class="hero">
    <div class="hero-content">
      <h1 class="hero-title">I BUILD THINGS</h1>
      <p class="hero-subtitle">Sometimes with code</p>
      <p class="hero-subtitle">Sometimes with stories</p>
      <p class="hero-subtitle">Sometimes with machines that hallucinate</p>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 clamp(1.5rem, 5vw, 4rem);
  }

  .hero-content {
    max-width: 1200px;
    margin-left: clamp(2rem, 8vw, 8rem);
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }

  .hero-subtitle {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 400;
    line-height: 1.4;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .hero-content {
      margin-left: 0;
    }
  }
</style>
