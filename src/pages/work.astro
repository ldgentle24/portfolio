---
import PageLayout from "../layouts/PageLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Rome Summer",
    description: "A visual journey through the eternal city",
    href: "/work/rome-summer",
  },
  {
    title: "Film Discovery",
    description: "Reimagining how we find and explore cinema",
    href: "/work/film-discovery",
  },
  {
    title: "The C That Behaves",
    description: "Machine learning meets creative advertising",
    href: "/work/ai-ads",
  },
  {
    title: "Same Pose, Better View",
    description: "One fashion moment, two cameras, one sharper view",
    href: "/work/same-pose-better-view",
  },
  {
    title: "The Disco Intruder",
    description: "A security alarm, a sneaky uncle, and a disco escape",
    href: "/work/disco-intruder",
  },
  {
    title: "The Delivery Hero",
    description: "A superhero fantasy interrupted by a camera chirp",
    href: "/work/delivery-hero",
  },
  {
    title: "Phin Time",
    description: "A visual ritual of Vietnamese coffee-making",
    href: "/work/phin-time",
  },
  {
    title: "Lady by the Lotus",
    description: "A modern echo of Vietnamese feminine grace",
    href: "/work/lady-lotus",
  },
  {
    title: "Automation Tools",
    description: "Building systems that work while you sleep",
    href: "/work/automation-tools",
  },
];
---

<PageLayout title="Work" description="Selected projects and case studies">
  <section class="work-section">
    <div class="container">
      <h1 class="work-title">Selected Work</h1>
      <a href="/work/archive" class="archive-card">
        <h2 class="archive-title">Archive</h2>
        <p class="archive-description">Earlier work in writing and community building</p>
      </a>
      <hr class="work-divider" />
      <div class="projects-grid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              href={project.href}
            />
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .work-section {
    min-height: 100vh;
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .work-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .archive-card {
    display: block;
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
  }

  .archive-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .archive-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .archive-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    opacity: 0.7;
    line-height: 1.6;
  }

  .work-divider {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    margin: clamp(2rem, 4vw, 3rem) 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
