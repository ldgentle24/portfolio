---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact" description="Get in touch">
  <section class="contact-section">
    <div class="container">
      <h1 class="contact-title">Contact</h1>

      <div class="contact-content">
        <p class="lead">
          Interested in working together? Have a project in mind? Let's talk.
        </p>

        <div class="contact-methods">
          <div class="contact-item">
            <h2>Email</h2>
            <a href="mailto:nguyenkimngocanh2627@gmail.com" class="contact-link">
              nguyenkimngocanh2627@gmail.com
            </a>
          </div>

          <div class="contact-item">
            <h2>Social</h2>
            <div class="social-links">
              <a href="https://github.com/ldgentle24" target="_blank" rel="noopener noreferrer" class="contact-link">
                GitHub
              </a>
              <a href="https://www.linkedin.com/in/nguy%E1%BB%85n-kim-ng%E1%BB%8Dc-anh-3739a2216/" target="_blank" rel="noopener noreferrer" class="contact-link">
                LinkedIn
              </a>
            </div>
          </div>
        </div>

        <p class="note">
          I typically respond within 24-48 hours. For urgent inquiries, please
          mention that in your subject line.
        </p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contact-section {
    min-height: 100vh;
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .contact-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .contact-content {
    max-width: 800px;
  }

  .lead {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.5;
    margin-bottom: clamp(3rem, 6vw, 4rem);
    opacity: 0.9;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .contact-item h2 {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    margin-bottom: 1rem;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
  }

  .contact-link {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    display: inline-block;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
  }

  .contact-link:hover {
    border-bottom-color: rgba(255, 255, 255, 0.6);
    opacity: 1;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .note {
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    opacity: 0.6;
    line-height: 1.6;
  }
</style>
