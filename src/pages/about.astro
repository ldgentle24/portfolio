---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="About" description="About me and what I do">
  <section class="about-section">
    <div class="container">
      <h1 class="about-title">About</h1>

      <div class="pixel-gallery">
        <div class="pixel-gallery-container" id="pixelGallery">
          <img src="/pixel/pixel1.png" alt="Pixel art 1" class="pixel-image" />
          <img src="/pixel/pixel2.png" alt="Pixel art 2" class="pixel-image" />
          <img src="/pixel/pixel3.png" alt="Pixel art 3" class="pixel-image" />
        </div>
        <div class="pixel-dots">
          <span class="dot active" data-index="0"></span>
          <span class="dot" data-index="1"></span>
          <span class="dot" data-index="2"></span>
        </div>
      </div>

      <div class="about-content">
        <p class="lead">
          I build things that matter—sometimes with code, sometimes with stories,
          sometimes with machines that hallucinate.
        </p>

        <p>
          My work sits at the intersection of technology and creativity. I'm
          interested in systems that scale, narratives that resonate, and
          interfaces that feel inevitable.
        </p>

        <p>
          I've worked on everything from automation tools that save hours of
          manual work to visual projects that capture fleeting moments. The
          common thread: attention to detail and a bias toward simplicity.
        </p>

        <p>
          Currently exploring AI-assisted creative workflows and building tools
          that make complex tasks feel effortless.
        </p>

        <div class="skills">
          <h2>What I work with</h2>
          <ul>
            <li>JavaScript/TypeScript, Python, React</li>
            <li>AI/ML tools and APIs</li>
            <li>Automation & workflow design</li>
            <li>Photography & visual storytelling</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .about-section {
    min-height: 100vh;
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .about-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .about-content {
    max-width: 800px;
  }

  .lead {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.5;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .about-content p {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    opacity: 0.85;
  }

  .skills {
    margin-top: clamp(3rem, 6vw, 4rem);
  }

  .skills h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1.5rem;
  }

  .skills ul {
    list-style: none;
    padding: 0;
  }

  .skills li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.85;
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .skills li::before {
    content: '—';
    position: absolute;
    left: 0;
  }

  /* Pixel Gallery Styles */
  .pixel-gallery {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    width: 100%;
  }

  .pixel-gallery-container {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    overflow: hidden;
    justify-content: space-between;
  }

  .pixel-image {
    flex: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
    transition: transform 0.3s ease;
    max-width: calc((100% - (2 * 1.5rem)) / 3);
  }

  .pixel-image:hover {
    transform: scale(1.02);
  }

  .pixel-dots {
    display: none;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: rgba(255, 255, 255, 0.9);
    width: 24px;
    border-radius: 4px;
  }

  /* Mobile and Tablet - Swipeable Carousel */
  @media (max-width: 1024px) {
    .pixel-gallery-container {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0;
    }

    .pixel-gallery-container::-webkit-scrollbar {
      display: none;
    }

    .pixel-image {
      flex: 0 0 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      max-width: 100%;
    }

    .pixel-image:hover {
      transform: none;
    }

    .pixel-dots {
      display: flex;
    }
  }

  /* Laptop and Desktop - All 3 in a row */
  @media (min-width: 1025px) {
    .pixel-gallery-container {
      max-width: 1400px;
      margin: 0 auto;
    }

    .pixel-image {
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.getElementById('pixelGallery');
    const dots = document.querySelectorAll('.dot');

    if (!gallery || dots.length === 0) return;

    // Update active dot based on scroll position
    const updateActiveDot = () => {
      const scrollLeft = gallery.scrollLeft;
      const imageWidth = gallery.offsetWidth;
      const currentIndex = Math.round(scrollLeft / imageWidth);

      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    };

    // Scroll to specific image when dot is clicked
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0');
        const imageWidth = gallery.offsetWidth;
        gallery.scrollTo({
          left: imageWidth * index,
          behavior: 'smooth'
        });
      });
    });

    // Listen for scroll events
    let scrollTimeout: number;
    gallery.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(updateActiveDot, 50);
    });

    // Initialize
    updateActiveDot();
  });
</script>
