---
import PageLayout from '../../layouts/PageLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import showcaseData from '../../data/showcases/film-discovery.json';
---

<PageLayout title="Film Discovery" description="Reimagining how we find and explore cinema">
  <article class="project">
    <div class="container">
      <header class="project-header">
        <h1 class="project-title">Film Discovery</h1>
        <p class="project-tagline">Reimagining how we find and explore cinema</p>
      </header>

      <div class="project-hero">
        <img
          src="/images/showcases/film-discovery/hero-ui.jpeg"
          alt="Film Discovery Platform - Movie detail page interface"
          class="hero-image"
        />
      </div>

      <div class="project-content">
        <section class="content-section">
          <h2>What it is</h2>
          <p>
            A web application that helps users discover films through mood, theme,
            and visual style rather than traditional genre classifications.
          </p>
        </section>

        <section class="content-section">
          <h2>What problem it solves</h2>
          <p>
            Most film recommendation systems rely on genre tags and ratings, which
            often fail to capture the emotional or aesthetic qualities that make
            a film memorable. This tool uses a more nuanced approach to matching
            viewers with films they'll love.
          </p>
        </section>

        <section class="content-section">
          <h2>Tools & methods</h2>
          <ul>
            <li>React & TypeScript</li>
            <li>TMDb API integration</li>
            <li>Custom recommendation algorithm</li>
            <li>Responsive design with Tailwind CSS</li>
          </ul>
        </section>
      </div>

      <!-- Image Gallery Showcase -->
      <ImageGallery
        showcaseData={showcaseData}
        showCaptions={true}
        captionPosition="below"
      />
    </div>
  </article>
</PageLayout>

<style>
  .project {
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .project-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .project-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: 1rem;
  }

  .project-tagline {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    opacity: 0.7;
  }

  .project-hero {
    margin-bottom: clamp(4rem, 8vw, 6rem);
  }

  .hero-image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: block;
  }

  .project-content {
    max-width: 800px;
  }

  .content-section {
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .content-section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }

  .content-section p {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.9;
  }

  .content-section ul {
    list-style: none;
    padding: 0;
  }

  .content-section li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.9;
    padding-left: 1.5rem;
    position: relative;
  }

  .content-section li::before {
    content: '—';
    position: absolute;
    left: 0;
  }
</style>
