---
import PageLayout from '../../layouts/PageLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import showcaseData from '../../data/showcases/phin-time.json';
---

<PageLayout title="Phin Time" description="A visual ritual of Vietnamese coffee-making">
  <article class="project">
    <div class="container">
      <header class="project-header">
        <h1 class="project-title">Phin Time</h1>
        <p class="project-tagline">A visual ritual of Vietnamese coffee-making</p>
      </header>

      <div class="project-hero">
        <div class="video-wrapper">
          <iframe
            src="https://www.youtube.com/embed/7KMUkV0XJoQ"
            title="Phin Time - Vietnamese Coffee Ritual"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="hero-video"
          ></iframe>
        </div>
      </div>

      <div class="project-content">
        <section class="content-section">
          <h2>What it is</h2>
          <p>
            A short-form visual project (30–40 seconds) that captures the ritual of making
            traditional Vietnamese milk coffee. Told through hand-drawn watercolor and ink-style
            visuals, it focuses on texture, pacing, and quiet satisfaction rather than speed or hype.
          </p>
        </section>

        <section class="content-section">
          <h2>What problem it solves</h2>
          <p>
            Most coffee content is either aggressively aesthetic or painfully instructional.
            This project strips things back and treats coffee-making as a calm, tactile ritual—something
            you watch to feel grounded, not to learn ratios. It celebrates process over performance.
          </p>
        </section>

        <section class="content-section">
          <h2>Style & approach</h2>
          <p>
            Hand-drawn watercolor and ink illustration in a rustic recipe-book style.
            Soft imperfections, visible grain, gentle motion—like something you'd find scribbled
            in the margins of a well-loved notebook rather than optimized for an algorithm.
          </p>
        </section>

        <section class="content-section">
          <h2>Tools & methods</h2>
          <ul>
            <li>Video generation: Higgsfield</li>
            <li>Image generation: Nano Banana Pro</li>
            <li>Editing & pacing: CapCut Pro</li>
          </ul>
        </section>
      </div>

      <!-- Image Gallery Showcase -->
      <ImageGallery
        showcaseData={showcaseData}
        showCaptions={true}
        captionPosition="below"
      />
    </div>
  </article>
</PageLayout>

<style>
  .project {
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .project-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .project-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: 1rem;
  }

  .project-tagline {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    opacity: 0.7;
  }

  .project-hero {
    margin-bottom: clamp(4rem, 8vw, 6rem);
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .project-content {
    max-width: 800px;
  }

  .content-section {
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .content-section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }

  .content-section p {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.9;
  }

  .content-section ul {
    list-style: none;
    padding: 0;
  }

  .content-section li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.9;
    padding-left: 1.5rem;
    position: relative;
  }

  .content-section li::before {
    content: '—';
    position: absolute;
    left: 0;
  }
</style>
