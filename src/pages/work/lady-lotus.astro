---
import PageLayout from "../../layouts/PageLayout.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import showcaseData from "../../data/showcases/lady-lotus.json";
---

<PageLayout
  title="Lady by the Lotus"
  description="A visual ritual of Vietnamese coffee-making"
>
  <article class="project">
    <div class="container">
      <header class="project-header">
        <h1 class="project-title">Lady by the Lotus</h1>
        <p class="project-tagline">
          A modern echo of Vietnamese feminine grace
        </p>
      </header>

      <div class="project-hero">
        <div class="pixel-gallery">
          <div class="pixel-gallery-container" id="pixelGallery">
            <img
              src="/images/showcases/lady-lotus/lady_lotus1.png"
              alt="Lady lotus 1"
              class="pixel-image"
            />
            <img
              src="/images/showcases/lady-lotus/lady_lotus2.png"
              alt="Lady lotus 2"
              class="pixel-image"
            />
            <img
              src="/images/showcases/lady-lotus/lady_lotus3.png"
              alt="Lady lotus 3"
              class="pixel-image"
            />
          </div>
          <div class="pixel-dots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
          </div>
        </div>
      </div>

      <div class="project-content">
        <section class="content-section">
          <h2>What it is</h2>
          <p>
            A visual lookbook project showcasing a traditional Vietnamese áo dài
            through AI-generated fashion imagery. The focus is on presenting the
            product across multiple poses and a carefully matched environment,
            demonstrating how AI models can be styled, placed, and directed to
            serve real advertising and branding needs.
          </p>
        </section>

        <section class="content-section">
          <h2>What problem it solves</h2>
          <p>
            Fashion and cultural products often struggle to visualize how
            they’ll look across different contexts without costly photoshoots.
            This project demonstrates a streamlined alternative: using AI to
            create a model that fits the product’s identity, present it in
            varied poses, and place it into a cohesive scene—while preserving
            elegance, cultural sensitivity, and brand intent.
          </p>
        </section>

        <section class="content-section">
          <h2>Style & approach</h2>
          <p>
            Soft, refined, and painterly. The final look draws inspiration from
            “Thiếu nữ bên hoa huệ” (Young Girl by Lilies) by Tô Ngọc Vân,
            echoing its celebration of the gentle grace and quiet dignity of
            Vietnamese women. The imagery prioritizes harmony between model,
            garment, and space—calm, poised, and timeless rather than
            trend-driven.
          </p>
        </section>

        <section class="content-section">
          <h2>Tools & methods</h2>
          <ul>
            <li>Image generation: Nano Banana Pro</li>
            <li>Editing & refinement: Adobe Photoshop</li>
          </ul>
        </section>
      </div>
      <!-- Image Gallery Showcase -->
      <ImageGallery
        showcaseData={showcaseData}
        showCaptions={true}
        captionPosition="below"
        imageOrientation="portrait"
      />
    </div>
  </article>
</PageLayout>

<style>
  .project {
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .project-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .project-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: 1rem;
  }

  .project-tagline {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    opacity: 0.7;
  }

  .project-hero {
    margin-bottom: clamp(4rem, 8vw, 6rem);
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .project-content {
    max-width: 800px;
  }

  .content-section {
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .content-section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }

  .content-section p {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.9;
  }

  .content-section ul {
    list-style: none;
    padding: 0;
  }

  .content-section li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.9;
    padding-left: 1.5rem;
    position: relative;
  }

  .content-section li::before {
    content: "—";
    position: absolute;
    left: 0;
  }

  /* Pixel Gallery Styles */
  .pixel-gallery {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    width: 100%;
  }

  .pixel-gallery-container {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    overflow: hidden;
    justify-content: space-between;
  }

  .pixel-image {
    flex: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
    transition: transform 0.3s ease;
    max-width: calc((100% - (2 * 1.5rem)) / 3);
  }

  .pixel-image:hover {
    transform: scale(1.02);
  }

  .pixel-dots {
    display: none;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: rgba(255, 255, 255, 0.9);
    width: 24px;
    border-radius: 4px;
  }

  /* Mobile and Tablet - Swipeable Carousel */
  @media (max-width: 1024px) {
    .pixel-gallery-container {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0;
    }

    .pixel-gallery-container::-webkit-scrollbar {
      display: none;
    }

    .pixel-image {
      flex: 0 0 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      max-width: 100%;
    }

    .pixel-image:hover {
      transform: none;
    }

    .pixel-dots {
      display: flex;
    }
  }

  /* Laptop and Desktop - All 3 in a row */
  @media (min-width: 1025px) {
    .pixel-gallery-container {
      max-width: 1400px;
      margin: 0 auto;
    }

    .pixel-image {
      aspect-ratio: 9 / 16;
      object-fit: cover;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const gallery = document.getElementById("pixelGallery");
    const dots = document.querySelectorAll(".dot");

    if (!gallery || dots.length === 0) return;

    // Update active dot based on scroll position
    const updateActiveDot = () => {
      const scrollLeft = gallery.scrollLeft;
      const imageWidth = gallery.offsetWidth;
      const currentIndex = Math.round(scrollLeft / imageWidth);

      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.add("active");
        } else {
          dot.classList.remove("active");
        }
      });
    };

    // Scroll to specific image when dot is clicked
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = parseInt(dot.getAttribute("data-index") || "0");
        const imageWidth = gallery.offsetWidth;
        gallery.scrollTo({
          left: imageWidth * index,
          behavior: "smooth",
        });
      });
    });

    // Listen for scroll events
    let scrollTimeout: number;
    gallery.addEventListener("scroll", () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(updateActiveDot, 50);
    });

    // Initialize
    updateActiveDot();
  });
</script>
